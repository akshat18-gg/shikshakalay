# Make your own copy with: npm run env:init   (creates .env.local — NEVER commit it)
# See what is missing with: npm run env:check (it never prints secret values)
# Put the same values in Render's settings (except DATABASE_URL_PROD, which is local-only).
# With USE_MOCKS=1 the app runs with none of these keys (fake engine, demo users in memory).

# --- App ---
USE_MOCKS=1
PUBLIC_BASE_URL=http://localhost:3000        # Render: https://<your-app>.onrender.com (no trailing slash)
TURNS_PER_HOUR_LIMIT=40
AI_DAILY_BUDGET_USD=10                        # the app stops calling Claude for the day after this much spend (sum of ai_calls)

# --- Claude (paid from the team's $500 credits) ---
ANTHROPIC_API_KEY=                            # the APP's key (own Console workspace + spend limit), not the coding agent's login
DIRECTOR_MODEL=claude-haiku-5-5
CHILD_MODEL=claude-haiku-5-5
COACH_MODEL=claude-sonnet-5-5
EVAL_GEN_MODEL=claude-opus-5-5

# --- Database (Neon, POOLED connection strings: the host contains "-pooler") ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_PROD=                            # local only: Neon MAIN branch, used when DB_TARGET=prod (db:push:prod, db:seed:prod)

# --- Logins ---
SESSION_SECRET=                               # long random string: npm run env:init fills it
DEMO_PIN=1234                                 # demo-only PIN for teacher_demo / trainer_demo / admin_demo (goes in the README)

# --- Voice ---
SARVAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# --- WhatsApp (Twilio sandbox) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN_CODE=join your-code-here

# --- Background sweep (UptimeRobot calls /api/cron/sweep?key=...) ---
CRON_SECRET=                                  # random string: npm run env:init fills it
