{
  "name": "shikshakalay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write --no-error-on-unmatched-pattern src tests scripts evals",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src tests scripts evals",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "env:init": "tsx scripts/env-tools.ts init",
    "env:check": "tsx scripts/env-tools.ts check",
    "db:push": "drizzle-kit push",
    "db:push:prod": "DB_TARGET=prod drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:seed:prod": "DB_TARGET=prod tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "evals": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "gen:lessons": "tsx --env-file-if-exists=.env.local evals/generate.ts",
    "smoke:live": "tsx --env-file-if-exists=.env.local scripts/smoke-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
